# Planning artifacts -- written to disk, never tracked.
# These read like documentation and sail past review, which is exactly why
# they are the leak vector. Back them up outside git, never by committing.
.planning/
plans/
docs/plans/
docs/superpowers/specs/
**/PLAN.md
**/*-PLAN.md
**/*-GOAL*.md
**/*RESEARCH*.md
**/*DISCUSSION-LOG*.md
**/*CONTEXT*.md
implementation-notes.md
SPEC.md
REVIEW.md
VERIFICATION.md

# Credentials -- OAuth tokens and client secrets.
.env
.env.*
!.env.example
token.json
*.token

# Retrieved content never goes through git. The JSON store and the derived
# bookmarks.db stay on each machine; pull-db.sh moves the db between machines
# over SSH (decided 2026-11-17: the db outgrew GitHub's 100 MB file limit).
store/
bookmarks.db
bookmarks.db.tmp
.incoming/
output/
*.jsonl
!tests/fixtures/*.jsonl

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# macOS
.DS_Store
