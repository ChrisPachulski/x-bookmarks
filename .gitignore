# Planning artifacts -- written to disk, never tracked.
# These read like documentation and sail past review, which is exactly why
# they are the leak vector. Back them up outside git, never by committing.
.planning/
plans/
docs/plans/
docs/superpowers/specs/
**/PLAN.md
**/*-PLAN.md
**/*-GOAL*.md
**/*RESEARCH*.md
**/*DISCUSSION-LOG*.md
**/*CONTEXT*.md
implementation-notes.md
SPEC.md
REVIEW.md
VERIFICATION.md

# Credentials -- OAuth tokens and client secrets.
.env
.env.*
!.env.example
token.json
*.token

# The JSON store stays untracked; bookmarks.db is the committed, compact
# derived copy (repo is PRIVATE -- re-check `git remote -v` before ever
# making it public, the db holds full retrieved content).
store/
output/
*.jsonl
!tests/fixtures/*.jsonl

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# macOS
.DS_Store
